MARKETBELL_ENV=production
MARKETBELL_PUBLIC_ORIGIN=https://YOUR-APPROVED-HOST
MARKETBELL_DATA_DIR=/data
# Replay works without a model key. Enable fresh inference only with a dedicated approved deployment key.
MARKETBELL_ALLOW_LIVE=0
MARKETBELL_SCHEDULER=0
MARKETBELL_WATCH=0
MARKETBELL_WATCH_SECONDS=300
MARKETBELL_DAILY_CALLS=60
# NEBIUS_API_KEY is supplied by your secret manager, never in image/source.
# APCA_API_KEY_ID and APCA_API_SECRET_KEY for authorized market data only.
# MARKETBELL_ADMIN_TOKEN is a new dedicated random value from your secret manager.
# MARKETBELL_WEBHOOK_TOKEN is a separate dedicated random value for authorized event integrations.

# Local estimated-spend reservations; verify provider rates before deployment.
MARKETBELL_DAILY_USD=0.50
MARKETBELL_MONTHLY_USD=10
MARKETBELL_EVENT_CALLS=12
MARKETBELL_INPUT_USD_M=0.30
MARKETBELL_OUTPUT_USD_M=0.90

# Local estimated-spend reservations; verify provider rates before deployment.

# --- Azure (set by infra/azure/main.bicep; listed here for reference, no values are secret) ---
# MARKETBELL_DATABASE_URL=postgresql://<app-identity>@<server>.postgres.database.azure.com:5432/marketbell?sslmode=require
# MARKETBELL_DATABASE_AUTH=managed-identity      # Entra ID token from the Container Apps identity; no DB password
# MARKETBELL_DB_SCHEMA=marketbell
# AZURE_CLIENT_ID=<user-assigned identity client id>
# MARKETBELL_TRUSTED_PROXY_HOPS=1                # Container Apps ingress adds one X-Forwarded-For hop
# MARKETBELL_WORKER=0                            # API container; the worker container runs backend.worker_main
# MARKETBELL_PUBLIC_DEMO=1                       # discard personal holding details from anonymous visitors
# MARKETBELL_INTERACTIVE_DAILY_CALLS=20
# Secrets come from Key Vault references: NEBIUS_API_KEY (worker), MARKETBELL_WEBHOOK_TOKEN and MARKETBELL_ADMIN_TOKEN (api).
