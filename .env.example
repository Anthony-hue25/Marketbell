# Server-only configuration. Never paste secrets into source, logs, or frontend.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_KEY_FILE=absolute path to an existing secure key file (local only)
# NEBIUS_API_KEY supplied by environment or dedicated deployment secret manager
MARKETBELL_DAILY_CALLS=60
MARKETBELL_ALLOW_LIVE=1
MARKETBELL_SCHEDULER=1
MARKETBELL_WATCH=1
MARKETBELL_WATCH_SECONDS=300
# MARKETBELL_WEBHOOK_TOKEN is an optional dedicated secret; at least 24 random characters
PORT=4318
# MARKETBELL_ALPACA_CACHE=absolute path to existing authorized Alpaca IEX download directory
# APCA_API_KEY_ID and APCA_API_SECRET_KEY may be supplied by an existing secure process loader
# MARKET_DATA_ENV_FILE=existing authorized Massive config path, only that named key is read
# MARKETBELL_DATA_DIR defaults to work/runtime (ignored)

# Local estimated-spend reservations; verify provider rates before deployment.
MARKETBELL_DAILY_USD=0.50
MARKETBELL_MONTHLY_USD=10
MARKETBELL_EVENT_CALLS=12
MARKETBELL_INPUT_USD_M=0.30
MARKETBELL_OUTPUT_USD_M=0.90

# Local estimated-spend reservations; verify provider rates before deployment.

# --- Added by the Azure readiness assurance (all optional locally) ---
# MARKETBELL_DATABASE_URL=postgresql://user@host:5432/marketbell?sslmode=require   (unset = local SQLite)
# MARKETBELL_WORKER=1                 # 0 = website/API only; run `python -m backend.worker_main` separately
# MARKETBELL_WORKER_CONCURRENCY=1     # parallel investigation slots in the one active worker
# MARKETBELL_INTERACTIVE_DAILY_CALLS=20   # visitor/workspace share of MARKETBELL_DAILY_CALLS
# MARKETBELL_SCAN_MAX_NEW=1           # new investigations queued per news scan

# --- Sources, triage and token savings (2026-10-21) ---
# SEC_USER_AGENT=MarketBell research you@example.com   # SEC EDGAR is free; this contact header is all it needs (no login, not a secret). Unset = SEC channel off.
# MARKETBELL_SKIP_ROUTINE_CHALLENGE=1   # skip the second review only when the first finds routine news on a stock you neither own nor watch
# MARKETBELL_INVESTIGATE_COMMENTARY=0   # 1 = also spend model calls on commentary / unknown publishers (tier 3)
# MARKETBELL_ASK_MODEL=1                # Ask MarketBell uses Nemotron when live inference is on; otherwise answers from records
# MARKETBELL_SLOW_CHANNEL_SECONDS=900   # SEC filing index and press-release search fetched at most this often per stock
# MARKETBELL_DAILY_REVIEW_MIN_MOVE=2    # daily baseline review calls the model only for a move of this % or last-day information
# MARKETBELL_DAILY_REVIEW_MAX=8         # most stocks the daily review sends to the model
